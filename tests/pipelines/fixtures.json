{
  "rulescope-catalog-rules-parse": [
    {
      "name": "custom query rule, 5m every 9m look-back",
      "input": {
        "raw": {
          "id": "r1",
          "name": "r1",
          "enabled": true,
          "type": "query",
          "interval": "5m",
          "from": "now-9m",
          "index": [
            "logs-system.*",
            "logs-windows.*"
          ],
          "timestamp_override": ""
        }
      },
      "expect": {
        "rulescope.rule.interval_s": 300,
        "rulescope.rule.lookback_s": 540,
        "rulescope.rule.additional_lookback_s": 240,
        "rulescope.rule.schedule_parsed": true,
        "rulescope.rule.timestamp_field": "@timestamp",
        "rulescope.rule.index_patterns_csv": "logs-system.*,logs-windows.*",
        "rulescope.rule.timestamp_override": null,
        "raw": null,
        "@timestamp": "*"
      }
    },
    {
      "name": "hourly rule with seconds and hours",
      "input": {
        "raw": {
          "id": "r2",
          "type": "eql",
          "interval": "1h",
          "from": "now-3900s",
          "index": [
            "logs-*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.interval_s": 3600,
        "rulescope.rule.lookback_s": 3900,
        "rulescope.rule.schedule_parsed": true
      }
    },
    {
      "name": "30 second interval",
      "input": {
        "raw": {
          "id": "r3",
          "type": "threshold",
          "interval": "30s",
          "from": "now-1m",
          "index": [
            "logs-*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.interval_s": 30,
        "rulescope.rule.lookback_s": 60,
        "rulescope.rule.schedule_parsed": true
      }
    },
    {
      "name": "timestamp override to event.ingested",
      "input": {
        "raw": {
          "id": "r4",
          "type": "query",
          "interval": "5m",
          "from": "now-9m",
          "index": [
            "logs-*"
          ],
          "timestamp_override": "event.ingested",
          "timestamp_override_fallback_disabled": false
        }
      },
      "expect": {
        "rulescope.rule.timestamp_field": "event.ingested",
        "rulescope.rule.timestamp_override_fallback_disabled": false
      }
    },
    {
      "name": "machine learning rule has no index patterns",
      "input": {
        "raw": {
          "id": "r6",
          "type": "machine_learning",
          "interval": "15m",
          "from": "now-45m"
        }
      },
      "expect": {
        "rulescope.rule.type": "machine_learning",
        "rulescope.rule.index_patterns_csv": null,
        "rulescope.rule.schedule_parsed": true
      }
    },
    {
      "name": "data view rule",
      "input": {
        "raw": {
          "id": "r8",
          "type": "query",
          "interval": "5m",
          "from": "now-6m",
          "data_view_id": "security-solution-default"
        }
      },
      "expect": {
        "rulescope.rule.data_view_id": "security-solution-default",
        "rulescope.rule.index_patterns_csv": null
      }
    },
    {
      "name": "remote patterns kept apart from local ones",
      "input": {
        "raw": {
          "id": "r9",
          "type": "query",
          "interval": "5m",
          "from": "now-6m",
          "index": [
            "remote:logs-*",
            "logs-endpoint.events.*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.index_patterns_csv": "logs-endpoint.events.*",
        "rulescope.rule.index_patterns_remote": [
          "remote:logs-*"
        ],
        "rulescope.rule.index_patterns": [
          "remote:logs-*",
          "logs-endpoint.events.*"
        ]
      }
    },
    {
      "name": "only remote patterns",
      "input": {
        "raw": {
          "id": "r10",
          "type": "query",
          "interval": "5m",
          "from": "now-6m",
          "index": [
            "remote:logs-*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.index_patterns_csv": null,
        "rulescope.rule.index_patterns_remote": [
          "remote:logs-*"
        ]
      }
    },
    {
      "name": "junk schedule",
      "input": {
        "raw": {
          "id": "r11",
          "type": "query",
          "interval": "five minutes",
          "from": "yesterday",
          "index": [
            "logs-*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.schedule_parsed": false,
        "rulescope.rule.interval_s": null,
        "rulescope.rule.lookback_s": null,
        "rulescope.rule.interval_raw": "five minutes"
      }
    },
    {
      "name": "unparseable from",
      "input": {
        "raw": {
          "id": "r12",
          "type": "query",
          "interval": "5m",
          "from": "2026-01-01",
          "index": [
            "logs-*"
          ]
        }
      },
      "expect": {
        "rulescope.rule.schedule_parsed": false,
        "rulescope.rule.interval_s": 300,
        "rulescope.rule.lookback_s": null
      }
    },
    {
      "name": "prebuilt, customized, building block, ATT&CK",
      "input": {
        "raw": {
          "id": "r13",
          "type": "query",
          "interval": "5m",
          "from": "now-6m",
          "index": [
            "logs-*"
          ],
          "immutable": true,
          "rule_source": {
            "type": "external",
            "is_customized": true
          },
          "building_block_type": "default",
          "threat": [
            {
              "framework": "MITRE ATT&CK",
              "tactic": {
                "id": "TA0002",
                "name": "Execution"
              },
              "technique": [
                {
                  "id": "T1059",
                  "name": "Command and Scripting Interpreter",
                  "subtechnique": [
                    {
                      "id": "T1059.001"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "rulescope.rule.prebuilt": true,
        "rulescope.rule.source.is_customized": true,
        "rulescope.rule.building_block": true,
        "rulescope.rule.threat.tactic.id": [
          "TA0002"
        ],
        "rulescope.rule.threat.technique.id": [
          "T1059"
        ],
        "rulescope.rule.threat.subtechnique.id": [
          "T1059.001"
        ]
      }
    },
    {
      "name": "query is stored only as a hash",
      "input": {
        "raw": {
          "id": "r14",
          "type": "query",
          "interval": "5m",
          "from": "now-6m",
          "index": [
            "logs-*"
          ],
          "query": "process.name : cmd.exe"
        }
      },
      "expect": {
        "rulescope.rule.query_hash": "*",
        "rulescope.rule.query": null
      }
    },
    {
      "name": "missing raw rule fails into on_failure",
      "input": {
        "rulescope": {}
      },
      "expect": {
        "rulescope.parse_error": "*"
      }
    }
  ],
  "rulescope-catalog-streams-parse": [
    {
      "name": "system security",
      "input": {
        "data_stream": {
          "name": "logs-system.security-default"
        }
      },
      "expect": {
        "data_stream.type": "logs",
        "data_stream.dataset": "system.security",
        "data_stream.namespace": "default",
        "@timestamp": "*"
      }
    },
    {
      "name": "endpoint process, custom namespace",
      "input": {
        "data_stream": {
          "name": "logs-endpoint.events.process-prod"
        }
      },
      "expect": {
        "data_stream.dataset": "endpoint.events.process",
        "data_stream.namespace": "prod",
        "@timestamp": "*"
      }
    },
    {
      "name": "too many hyphens is kept but never joins",
      "input": {
        "data_stream": {
          "name": "logs-foo-bar-baz"
        }
      },
      "expect": {
        "data_stream.dataset": null,
        "data_stream.namespace": null,
        "rulescope.parse_error": "*",
        "@timestamp": "*"
      }
    },
    {
      "name": "no hyphens",
      "input": {
        "data_stream": {
          "name": "winlogbeat"
        }
      },
      "expect": {
        "data_stream.dataset": null,
        "rulescope.parse_error": "*"
      }
    },
    {
      "name": "empty numbers from the template are dropped",
      "input": {
        "data_stream": {
          "name": "logs-a-default"
        },
        "rulescope": {
          "rule": {
            "id": "x",
            "interval_s": "",
            "lookback_s": 360
          }
        }
      },
      "expect": {
        "rulescope.rule.interval_s": null,
        "rulescope.rule.lookback_s": 360
      }
    }
  ],
  "rulescope-stamp": [
    {
      "name": "adds a timestamp",
      "input": {
        "status": "success"
      },
      "expect": {
        "@timestamp": "*"
      }
    },
    {
      "name": "keeps an existing timestamp",
      "input": {
        "@timestamp": "2026-11-13T10:00:00.000Z"
      },
      "expect": {
        "@timestamp": "2026-11-13T10:00:00.000Z"
      }
    }
  ]
}
